# ============================================
# SUPABASE - skopiuj z: supabase.com > Settings > API
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ_PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...twoj_klucz_anon

# Klucz SERVICE ROLE (tylko backend, nigdy nie ujawniaj publicznie!)
SUPABASE_SERVICE_ROLE_KEY=eyJ...twoj_klucz_service_role

# ============================================
# EMAIL - dane do wysyłki powiadomień
# (przykład dla Gmail z App Password)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=twoj@gmail.com
# Wygeneruj App Password: myaccount.google.com/apppasswords
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=twoj@gmail.com
# Na ten adres przyjdą powiadomienia o rezerwacjach
ADMIN_EMAIL=twoj@gmail.com

# ============================================
# PANEL ADMINA - ustaw własne hasło!
# ============================================
ADMIN_PASSWORD=ZmienNaMocneHaslo2024!
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=wygeneruj_losowy_string_min_32_znaki_tu

# ============================================
# URL aplikacji (zmień po wdrożeniu)
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
